all:
  vars:
  hosts:
    gpu_server:
      gpu_power_limit: 225
      llama_cpp:
        src_models_dir: /home/jim/llama_cpp_models
        baremetal:
          install:
            vulkan: true
            rocm: true
          server:
            enabled: true
            compute_backend: rocm
            max_models: 1
            port: 8080
            tensor_split:
              - 1
              - 1
              - 1
              - 1
            tls:
              server_key: /home/jim/gpu-server-secrets/server.key
              server_cert: /home/jim/gpu-server-secrets/server.crt
              ca_cert: /home/jim/gpu-server-secrets/ca.crt
            api_keys: /home/jim/gpu-server-secrets/api_keys
      notebook:
        enabled: false
        main_port: 8000
        additional_ports: "7860-7870"
        image_name: "local-uv-amd:v1"
        mapped_volumes:
          - host_dir: "/var/lib/notebook/workdir"
            container_dir: "/opt/workdir"
        additional_packages: ["huggingface_hub", "diffusers", "transformers", "accelerate", "soundfile", "datasets", "sentencepiece", "requests", "bitsandbytes"]
        tls:
          server_cert: /home/jim/gpu-server-secrets/server.crt
          server_key: /home/jim/gpu-server-secrets/server.key
        jupyter_token: /home/jim/gpu-server-secrets/api_keys
        hf_token: /home/jim/gpu-server-secrets/hf_token