uv init
uv run --with python-dotenv \
       --with jupyter -- jupyter notebook \
       --port {{ notebook.main_port }} \
       --allow-root \
{% if notebook.tls is defined and notebook.server_cert is defined and notebook.tls.server_key is defined %}
       --certfile "SERVER_TLS_CERT=/etc/notebook/tls/server.crt" \
       --keyfile "SERVER_TLS_KEY=/etc/notebook/tls/server.key" \
{% endif %}
       --ip 0.0.0.0 \
       --no-browser