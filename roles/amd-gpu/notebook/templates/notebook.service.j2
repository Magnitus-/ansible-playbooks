[Unit]
Description=Notebook Service
After=containerd.service
Requires=containerd.service

[Service]
Type=simple
{% if notebook.jupyter_token is defined %}
EnvironmentFile=/etc/notebook/jupyter_token_env
{% endif %}
ExecStartPre=nerdctl rm -f notebook
ExecStart=nerdctl run --rm \
  --device amd.com/gpu=all \
  --name notebook \
  -v /etc/notebook/entrypoint/entrypoint.sh:/usr/local/bin/entrypoint.sh \
{% if notebook.tls is defined and notebook.server_cert is defined and notebook.tls.server_key is defined %}
  -v /etc/notebook/tls:/etc/notebook/tls \
{% endif %}
{% for host_path, container_path in notebook.mapped_volumes.items() %}
  -v {{ host_path }}:{{ container_path }} \
{% endfor %}
  -p 0.0.0.0:{{ notebook.main_port }}:{{ notebook.main_port }} \
{% if notebook.additional_ports is defined %}
  -p 0.0.0.0:{{ notebook.additional_ports }}:{{ notebook.additional_ports }} \
{% endif %}
{% if notebook.container_workdir is defined %}
  -w {{ notebook.container_workdir }} \
{% endif %}
  {{ notebook.image_name }} /usr/local/bin/entrypoint.sh
ExecStop=nerdctl stop notebook

Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target